# Copy this file to .env and fill in your credentials

EASYNEWS_USER=your_easynews_username
EASYNEWS_PASS=your_easynews_password

# API key used by Prowlarr/Newznab clients to authenticate to this server
NEWZNAB_APIKEY=testkey

# Optional: override server port (default 8081)
# PORT=8081

# Optional: Easynews host; must start with http:// or https:// (trailing slash is stripped)
# EASYNEWS_BASE_URL=https://members.easynews.com

# Optional: minimum file size in MB; default and floor for ?minsize=
# DEFAULT_MIN_SIZE_MB=100

# Optional: results fetched from Easynews per search and the ceiling for DEFAULT_LIMIT
# (bounded 100-1000; 250 default). On the 3.0 API this fetches ceil(MAX_RESULTS/100)
# pages, so 500 = 5 page requests per search. Raise for NZBgeek-level volume.
# MAX_RESULTS=250

# Optional: result count when ?limit= is absent and the maximum for ?limit=
# (advertised in caps; capped at MAX_RESULTS). Set both to go above 250.
# DEFAULT_LIMIT=250

# Optional: Easynews search API, "3.0" (default: relevance-ranked when no sort is sent,
# richer fields, ~10 concurrent searches per account) or "2.0" (legacy Solr endpoint)
# EASYNEWS_API_VERSION=3.0

# Optional: max in-flight Easynews searches per process (default 2; Easynews drops
# over-cap requests with an empty body). Keep GUNICORN_WORKERS=1 so it holds account-wide.
# EASYNEWS_MAX_CONCURRENT_SEARCHES=2

# Optional: gunicorn worker processes / threads (Docker image only; defaults 1 / 8)
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=8

# Optional: strict title matching for t=movie / t=tvsearch (default on)
# STRICT_MATCHING=1

# Optional: seconds to cache raw Easynews search responses (default 120, 0 disables).
# Per gunicorn worker process; see README "Search cache".
# CACHE_TTL_SECONDS=120
